{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "runClient",
      "request": "launch",
      "mainClass": "net.minecraftforge.bootstrap.ForgeBootstrap",
      "projectName": "forge-1.21-51.0.33-mdk",
      "cwd": "${workspaceFolder}/run",
      "vmArgs": "-Dforge.logging.console.level=debug -Dforge.logging.markers=REGISTRIES -Dforge.enabledGameTestNamespaces=horrormod -Dforge.enableGameTest=true -Djava.net.preferIPv6Addresses=system",
      "args": "--launchTarget forge_userdev_client --version MOD_DEV --assetIndex 17 --assetsDir /home/y/.gradle/caches/forge_gradle/assets --gameDir . --mixin.config horrormod.mixins.json",
      "env": {
        "MOD_CLASSES": "${workspaceFolder}/build/sourcesSets/main",
        "MCP_MAPPINGS": "parchment_2024.07.28-1.21"
      },
      "preLaunchTask": "prepareRunClientCompile",
      "classPaths": [
        "$Auto",
        "!${workspaceFolder}/bin/main",
        "!${workspaceFolder}/bin/test",
        "${workspaceFolder}/build/sourcesSets/main"
      ]
    },
